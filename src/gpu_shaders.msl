/* Metal Shading Language (MSL) shaders for lite-xl GPU renderer.
 *
 * SDL_gpu's Metal backend compiles MSL *source strings* at runtime via
 * [MTLDevice newLibraryWithSource:options:error:], so no offline metal
 * compiler is needed — we just embed the source as C string literals.
 *
 * Binding conventions (per SDL_gpu Metal backend):
 *   - Vertex attributes come via [[stage_in]] + [[attribute(n)]]; the actual
 *     vertex buffer occupies Metal slot 14+ (METAL_FIRST_VERTEX_BUFFER_SLOT),
 *     managed by SDL_gpu — the shader never references it directly.
 *   - Uniform buffers: [[buffer(0)]] for both vertex and fragment stages
 *     (they're separate address spaces, no conflict).
 *   - Samplers/textures: [[sampler(0)]] / [[texture(0)]] in fragment stage.
 *
 * Coordinate convention: pixel coords (top-left origin) -> NDC in vertex
 * shader. Y flipped so pixel y=0 (top) maps to NDC y=+1 (top), because
 * Metal's framebuffer origin is top-left but NDC Y is up.
 */

#include <metal_stdlib>
using namespace metal;

/*=============================================================================
 * Stage 2a: solid-color rectangle
 *===========================================================================*/

typedef struct {
  float2 position [[attribute(0)]];
  float2 texcoord [[attribute(1)]];
  float4 color    [[attribute(2)]];  /* per-vertex tint (UBYTE4_NORM) */
} RectVertexIn;

typedef struct {
  float4 position [[position]];
  float4 color;
} RectVertexOut;

/* Vertex uniform: viewport size in pixels (zw unused, vec4 for std140). */
typedef struct {
  float4 viewport;
} RectVertexUniform;

vertex RectVertexOut
lite_rect_vertex(RectVertexIn in [[stage_in]],
                 constant RectVertexUniform &u [[buffer(0)]])
{
  RectVertexOut out;
  float x = (in.position.x / u.viewport.x) * 2.0 - 1.0;
  float y = 1.0 - (in.position.y / u.viewport.y) * 2.0;
  out.position = float4(x, y, 0.0, 1.0);
  out.color = in.color;
  return out;
}

fragment float4
lite_rect_fragment(RectVertexOut in [[stage_in]])
{
  return in.color; /* per-vertex tint (straight alpha) */
}

/*=============================================================================
 * Stage 2a': rounded rectangle (SDF, antialiased)
 *
 * Same vertex layout as the plain rect (position + float2), but the second
 * attribute carries LOCAL pixel coordinates inside the quad (not normalized
 * texcoords).  The fragment shader evaluates a rounded-box signed distance
 * and fades the edge over one pixel, giving true analytic antialiasing.
 * Fragment uniform: color.rgba, then (radius, width, height, unused).
 * Output is premultiplied; the pipeline blends with ONE / 1-SRC_ALPHA.
 *===========================================================================*/

typedef struct {
  float2 position [[attribute(0)]];
  float2 local [[attribute(1)]];
} RRectVertexIn;

typedef struct {
  float4 position [[position]];
  float2 local;
} RRectVertexOut;

typedef struct {
  float4 viewport;
} RRectVertexUniform;

vertex RRectVertexOut
lite_rrect_vertex(RRectVertexIn in [[stage_in]],
                  constant RRectVertexUniform &u [[buffer(0)]])
{
  RRectVertexOut out;
  float x = (in.position.x / u.viewport.x) * 2.0 - 1.0;
  float y = 1.0 - (in.position.y / u.viewport.y) * 2.0;
  out.position = float4(x, y, 0.0, 1.0);
  out.local = in.local;
  return out;
}

typedef struct {
  float4 color;  /* straight alpha */
  float4 shape;  /* x = corner radius (px), y = quad width (px),
                    z = quad height (px), w unused */
} RRectFragmentUniform;

fragment float4
lite_rrect_fragment(RRectVertexOut in [[stage_in]],
                    constant RRectFragmentUniform &u [[buffer(0)]])
{
  float2 half_size = float2(u.shape.y, u.shape.z) * 0.5;
  float r = min(u.shape.x, min(half_size.x, half_size.y));
  float2 q = abs(in.local - half_size) - (half_size - float2(r));
  float sd = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
  float coverage = saturate(0.5 - sd);   /* 1px antialiased edge */
  /* Premultiplied output: blend does result = src + dst*(1-alpha). */
  return float4(u.color.rgb * coverage, coverage);
}

/*=============================================================================
 * Stage 2b: textured rendering
 *
 * Premultiplied-alpha blending (ONE / ONE_MINUS_SRC_ALPHA). Glyphs are drawn
 * from a bound ARRAY of atlas textures selected per-vertex by tex_index, so
 * runs across different fonts/weights merge into one draw. Images use a single
 * texture in colour mode.
 *===========================================================================*/

#define GPU_ATLAS_COUNT 16

/* ---- Image (single texture, colour mode) ---- */

typedef struct {
  float2 position [[attribute(0)]];
  float2 texcoord [[attribute(1)]];
  float4 color    [[attribute(2)]];  /* per-vertex tint (UBYTE4_NORM) */
} ImageVertexIn;

typedef struct {
  float4 position [[position]];
  float2 texcoord;
  float4 color;
} ImageVertexOut;

typedef struct {
  float4 viewport;
} ImageVertexUniform;

vertex ImageVertexOut
lite_image_vertex(ImageVertexIn in [[stage_in]],
                  constant ImageVertexUniform &u [[buffer(0)]])
{
  ImageVertexOut out;
  float x = (in.position.x / u.viewport.x) * 2.0 - 1.0;
  float y = 1.0 - (in.position.y / u.viewport.y) * 2.0;
  out.position = float4(x, y, 0.0, 1.0);
  out.texcoord = in.texcoord;
  out.color = in.color;
  return out;
}

fragment float4
lite_image_fragment(ImageVertexOut in [[stage_in]],
                    texture2d<float> atlas [[texture(0)]],
                    sampler atlasSampler [[sampler(0)]])
{
  float4 glyph = atlas.sample(atlasSampler, in.texcoord);
  float4 tint = in.color;
  /* colour mode: glyph provides RGB + alpha coverage */
  return float4(glyph.rgb * glyph.a * tint.a, glyph.a * tint.a);
}

/* ---- Glyph (atlas texture array, per-vertex tex_index) ---- */

typedef struct {
  float2 position [[attribute(0)]];
  float2 texcoord [[attribute(1)]];
  float4 color    [[attribute(2)]];  /* per-vertex tint (UBYTE4_NORM) */
  uint   tex_index [[attribute(3)]]; /* atlas texture array index (UINT) */
} GlyphVertexIn;

typedef struct {
  float4 position [[position]];
  float2 texcoord;
  float4 color;
  uint   tex_index;
} GlyphVertexOut;

typedef struct {
  float4 viewport;
} GlyphVertexUniform;

vertex GlyphVertexOut
lite_glyph_vertex(GlyphVertexIn in [[stage_in]],
                  constant GlyphVertexUniform &u [[buffer(0)]])
{
  GlyphVertexOut out;
  float x = (in.position.x / u.viewport.x) * 2.0 - 1.0;
  float y = 1.0 - (in.position.y / u.viewport.y) * 2.0;
  out.position = float4(x, y, 0.0, 1.0);
  out.texcoord = in.texcoord;
  out.color = in.color;
  out.tex_index = in.tex_index;
  return out;
}

/* Fragment uniform for glyph text. std140: vec4 + vec4 = 32 bytes.
 *   color: unused (tint is per-vertex now), kept for std140 layout
 *   mode:  x = 0 grayscale, 1 subpixel, 2 color (emoji) */
typedef struct {
  float4 color;
  float4 mode;
} GlyphFragmentUniform;

fragment float4
lite_glyph_fragment(GlyphVertexOut in [[stage_in]],
                    constant GlyphFragmentUniform &u [[buffer(0)]],
                    array<texture2d<float>, GPU_ATLAS_COUNT> atlases [[texture(0)]],
                    array<sampler, GPU_ATLAS_COUNT> atlasSamplers [[sampler(0)]])
{
  float4 glyph = atlases[in.tex_index].sample(atlasSamplers[in.tex_index], in.texcoord);
  float4 tint = in.color;
  int mode = int(u.mode.x);
  float coverage;
  float3 src_color;

  if (mode == 2) {
    /* Color emoji: glyph provides RGB + alpha coverage */
    coverage = glyph.a * tint.a;
    src_color = glyph.rgb;
  } else if (mode == 1) {
    /* Subpixel LCD: average R/G/B coverage (approximation) */
    coverage = (glyph.r + glyph.g + glyph.b) / 3.0 * tint.a;
    src_color = tint.rgb;
  } else {
    /* Grayscale: glyph.r is uniform coverage */
    coverage = glyph.r * tint.a;
    src_color = tint.rgb;
  }
  /* Premultiplied output: blend does result = src + dst*(1-alpha) */
  return float4(src_color * coverage, coverage);
}
